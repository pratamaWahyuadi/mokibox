# =====================================================
# TikTok Clone Backend MVP - Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit a real .env file.
# =====================================================

# --- PostgreSQL (admin / superuser) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=tiktok

# --- PostgreSQL application roles (used by API & Worker) ---
TIKTOK_API_DB_PASSWORD=change-me-tiktok-api
TIKTOK_WORKER_DB_PASSWORD=change-me-tiktok-worker

# --- Redis ---
REDIS_PASSWORD=change-me-redis
REDIS_ADDR=redis:6379

# --- Zitadel (self-hosted) ---
# Public issuer URL (must match Zitadel console external domain)
ZITADEL_ISSUER_URL=https://auth.example.com
# Web/OIDC application Client ID (login UI)
ZITADEL_CLIENT_ID=replace-with-zitadel-web-client-id
# API application Client ID (resource server / audience for JWT)
ZITADEL_API_CLIENT_ID=replace-with-zitadel-api-client-id
# HMAC signing key returned by Zitadel Actions V2 Target CreateTarget
ZITADEL_TARGET_SIGNING_KEY=replace-with-zitadel-target-signing-key
# Pinned Zitadel image version
ZITADEL_VERSION=v2.54.0

# --- Cloudflare R2 (S3-compatible) ---
R2_ACCOUNT_ID=replace-with-r2-account-id
R2_ACCESS_KEY_ID=replace-with-r2-access-key
R2_SECRET_ACCESS_KEY=replace-with-r2-secret-key
R2_BUCKET=tiktok-media
# R2 endpoint: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=https://replace-with-r2-account-id.r2.cloudflarestorage.com

# --- API & Media ---
API_BASE_URL=https://api.example.com
MEDIA_TOKEN_SECRET=change-me-media-token
MEDIA_TOKEN_TTL=15m

# --- Database connection strings (consumed by Go services) ---
# Used by api-gateway (role tiktok_api, full CRUD)
DATABASE_URL=postgres://tiktok_api:change-me-tiktok-api@postgres:5432/tiktok?sslmode=disable
# Used by transcoder-worker (role tiktok_worker, restricted)
WORKER_DATABASE_URL=postgres://tiktok_worker:change-me-tiktok-worker@postgres:5432/tiktok?sslmode=disable

# --- Upload & Transcode tuning ---
PRESIGN_UPLOAD_EXPIRY=15m
TRANSCODE_TIMEOUT=5m
